COQC := /home/au528660/.opam/rocq-9/bin/coqc
ROCQPATH := /home/au528660/.opam/rocq-9/lib/coq/user-contrib
COQFLAGS := -Q src Crypto

# Standard compilation
%.vo: %.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) $<

# .vos compilation: skip opaque proof bodies, much faster + less memory.
# Dependencies loaded from .vos don't carry proof terms in memory.
%.vos: %.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos $<

# .vok compilation: full proof checking but loads .vos for dependencies.
# Use after .vos to verify proofs without loading all dependency proofs.
%.vok: %.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vok $<

# Shortcut targets for BLS12 files
.PHONY: quad quad-mul quad-specs three_b felem_copy fp2 g1 g1_alt g2 bignum_shift curve_add cubic-specs cubic wp-tactics dodecic-specs dodecic pairing-ops
.PHONY: dodecic-mul dodecic-sqr dodecic-inv dodecic-all dodecic-all-vos
.PHONY: pairing-helpers miller-loop final-exp pairing-top pairing pairing-vos

quad:
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) src/Bedrock/Field/FieldExtensions/QuadraticFieldExtensions.v

quad-mul:
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) src/Bedrock/Field/FieldExtensions/QuadraticFieldExtensionsMul.v

