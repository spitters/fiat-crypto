	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos src/Bedrock/Field/Synthesis/Examples/BLS12_FinalExpH3.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos src/Bedrock/Field/Synthesis/Examples/BLS12_FinalExp.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos src/Bedrock/Field/Synthesis/Examples/BLS12_PairingTop.v

