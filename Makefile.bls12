	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos src/Bedrock/Field/FieldExtensions/DodecicFieldExtensionsMul.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos src/Bedrock/Field/FieldExtensions/DodecicFieldExtensionsSqr.v
	ROCQPATH=$(ROCQPATH) $(COQC) $(COQFLAGS) -vos src/Bedrock/Field/FieldExtensions/DodecicFieldExtensionsInv.v

